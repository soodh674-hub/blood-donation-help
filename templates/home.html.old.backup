{% extends 'base.html' %}
{% load static %}

{% block extra_css %}
<style>
    /* Full-screen layout - FIXED */
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }
    
    .page {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
    }
    
    /* BloodLife Dashboard Styles - SIMPLIFIED */
    .dashboard-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        width: 100%;
        padding: 20px;
        box-sizing: border-box; /* CRITICAL: prevents horizontal overflow */
    }
    
    .dashboard-header {
        background: white;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .dashboard-title {
        font-size: 28px;
        font-weight: bold;
        color: #dc2626;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .quick-actions {
        display: flex;
        gap: 15px;
    }
    
    .btn-primary {
        background: linear-gradient(45deg, #dc2626, #ef4444);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(220, 38, 38, 0.4);
    }
    
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        margin-bottom: 25px;
    }
    
    .panel {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    
    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f3f4f6;
    }
    
    .panel-title {
        font-size: 20px;
        font-weight: 600;
        color: #1f2937;
    }
    
    .live-requests {
        max-height: 400px;
        overflow-y: auto;
    }
    
    .request-card {
        background: #f9fafb;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 12px;
        border-left: 4px solid #dc2626;
        transition: all 0.3s ease;
    }
    
    .request-card.urgent {
        border-left-color: #f59e0b;
    }
    
    .request-card.emergency {
        border-left-color: #dc2626;
        animation: pulse-glow 2s infinite;
    }
    
    .request-card:hover {
        transform: translateX(5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    
    .request-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    
    .blood-type {
        font-size: 18px;
        font-weight: bold;
        color: #dc2626;
    }
    
    .urgency-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }
    
    .urgency-badge.emergency {
        background: #dc2626;
        color: white;
    }
    
    .urgency-badge.urgent {
        background: #f59e0b;
        color: white;
    }
    
    .urgency-badge.normal {
        background: #10b981;
        color: white;
    }
    
    .request-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }
    
    .location-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    
    .distance, .time-ago {
        font-size: 13px;
        color: #6b7280;
    }
    
    .btn-donate {
        background: #10b981;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .btn-donate:hover {
        background: #059669;
        transform: translateY(-1px);
    }
    
    .donor-list {
        max-height: 400px;
        overflow-y: auto;
    }
    
    .donor-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        background: #f9fafb;
        border-radius: 8px;
        margin-bottom: 10px;
        transition: all 0.3s ease;
    }
    
    .donor-card:hover {
        background: #f3f4f6;
        transform: translateX(3px);
    }
    
    .donor-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .donor-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #6b7280;
    }
    
    .donor-details {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    
    .donor-name {
        font-weight: 600;
        color: #1f2937;
    }
    
    .donor-distance {
        font-size: 13px;
        color: #6b7280;
    }
    
    .btn-view-profile {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .btn-view-profile:hover {
        background: #2563eb;
    }
    
    .map-container {
        height: 300px;
        background: #e5e7eb;
        border-radius: 10px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-size: 14px;
    }
    
    .track-info {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
    }
    
    .track-info-title {
        font-weight: 600;
        color: #92400e;
        margin-bottom: 5px;
    }
    
    .track-info-details {
        font-size: 14px;
        color: #78350f;
    }
    
    .search-filters {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 15px;
        margin-bottom: 20px;
    }
    
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    
    .filter-label {
        font-weight: 600;
        color: #374151;
        font-size: 14px;
    }
    
    .filter-select {
        padding: 10px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        background: white;
        font-size: 14px;
    }
    
    .notification-list {
        max-height: 350px;
        overflow-y: auto;
    }
    
    .notification-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px;
        background: #f9fafb;
        border-radius: 8px;
        margin-bottom: 10px;
        border-left: 3px solid #3b82f6;
        transition: all 0.3s ease;
    }
    
    .notification-item:hover {
        background: #f3f4f6;
    }
    
    .notification-item.emergency {
        border-left-color: #dc2626;
        background: #fef2f2;
    }
    
    .notification-item.urgent {
        border-left-color: #f59e0b;
        background: #fffbeb;
    }
    
    .notification-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .notification-icon.emergency {
        background: #dc2626;
        color: white;
    }
    
    .notification-icon.urgent {
        background: #f59e0b;
        color: white;
    }
    
    .notification-icon.info {
        background: #3b82f6;
        color: white;
    }
    
    .notification-content {
        flex: 1;
    }
    
    .notification-text {
        font-size: 14px;
        color: #1f2937;
        margin-bottom: 4px;
    }
    
    .notification-time {
        font-size: 12px;
        color: #6b7280;
    }
    
    .chat-container {
        height: 350px;
        display: flex;
        flex-direction: column;
    }
    
    .chat-messages {
        flex: 1;
        background: #f9fafb;
        border-radius: 8px;
        padding: 15px;
        overflow-y: auto;
        margin-bottom: 15px;
    }
    
    .chat-input-container {
        display: flex;
        gap: 10px;
    }
    
    .chat-input {
        flex: 1;
        padding: 10px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 14px;
    }
    
    .btn-send {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .btn-send:hover {
        background: #2563eb;
    }
    
    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #10b981;
        color: white;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    
    .live-dot {
        width: 8px;
        height: 8px;
        background: white;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
    
    @keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 5px rgba(220, 38, 38, 0.5); }
        50% { box-shadow: 0 0 20px rgba(220, 38, 38, 0.8); }
    }
    
    /* Responsive Design */
    @media (max-width: 768px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
    
    /* Enhanced hero section - SIMPLIFIED (removed animation) */
    .hero-section-enhanced {
        background: linear-gradient(135deg, #111827 0%, #1f2937 50%, #111827 100%);
    }
    
    /* Glassmorphism enhancements - SIMPLIFIED */
    .glass-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
    }
    
    .glass-card:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.25);
        transform: translateY(-2px); /* Reduced from -4px */
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); /* Reduced shadow */
    }
    
    /* Large screen optimizations */
    @media (min-width: 1440px) {
        .max-w-7xl {
            max-width: 85vw;
        }
        
        .hero-content {
            padding-top: 5rem;
            padding-bottom: 5rem;
        }
    }
    
    @media (min-width: 1920px) {
        .max-w-7xl {
            max-width: 80vw;
        }
        
        .max-w-4xl {
            max-width: 70vw;
        }
        
        .max-w-3xl {
            max-width: 65vw;
        }
        
        h1.text-4xl, h1.text-6xl {
            font-size: clamp(3rem, 5vw, 5.5rem);
        }
        
        .hero-content {
            padding-top: 6rem;
            padding-bottom: 6rem;
        }
        
        .glass-card {
            padding: 3rem;
        }
    }
    
    @media (min-width: 2560px) {
        .max-w-7xl {
            max-width: 75vw;
        }
        
        .max-w-4xl {
            max-width: 65vw;
        }
        
        .max-w-3xl {
            max-width: 60vw;
        }
        
        h1.text-4xl, h1.text-6xl {
            font-size: clamp(4rem, 6vw, 7rem);
        }
        
        body {
            font-size: 20px;
        }
        
        .hero-content {
            padding-top: 8rem;
            padding-bottom: 8rem;
        }
        
        .glass-card {
            padding: 4rem;
        }
        
        .btn, button {
            padding: 1.2rem 2.5rem;
            font-size: 1.2rem;
        }
    }
    
    @media (min-width: 3440px) {
        .max-w-7xl {
            max-width: 70vw;
        }
        
        body {
            font-size: 22px;
        }
    }
    
    /* Tablet optimizations */
    @media (min-width: 768px) and (max-width: 1024px) {
        .max-w-7xl {
            max-width: 90vw;
        }
        
        h1.text-4xl, h1.text-6xl {
            font-size: clamp(2rem, 4vw, 3rem);
        }
        
        .hero-content {
            padding-top: 3rem;
            padding-bottom: 3rem;
        }
    }
    
    /* Enhanced card hover effects - SIMPLIFIED */
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .hover-lift:hover {
        transform: translateY(-4px); /* Reduced from -8px */
        box-shadow: 0 15px 30px -8px rgba(0, 0, 0, 0.3); /* Reduced shadow */
    }
    
    /* Animated gradient buttons - REMOVED animation for performance */
    .btn-animated {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        position: relative;
        overflow: hidden;
    }
    
    /* Stats counter animation */
    .stat-value {
        background: linear-gradient(135deg, #ef4444, #f97316);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    /* Section dividers */
    .section-divider {
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(239, 68, 68, 0.5), transparent);
        margin: 4rem 0;
    }

    /* Mega Menu Styles */
    .mega-menu-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(10px); z-index: 9999; animation: fadeIn 0.3s ease; overflow-y: auto; }
    .mega-menu-overlay.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .mega-menu-content { max-width: 1200px; margin: 80px auto 40px; padding: 0 20px; }
    .mega-menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
    .mega-menu-section { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); }
    .mega-menu-title { font-size: 18px; font-weight: bold; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 2px solid #f3f4f6; display: flex; align-items: center; gap: 8px; }
    .mega-menu-list { list-style: none; padding: 0; margin: 0; }
    .mega-menu-item { margin-bottom: 8px; }
    .mega-menu-link { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; color: #374151; text-decoration: none; transition: all 0.3s ease; }
    .mega-menu-link:hover { background: #f3f4f6; color: #dc2626; transform: translateX(4px); }
    .mega-menu-close { position: fixed; top: 20px; right: 20px; width: 48px; height: 48px; background: white; border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(0,0,0,0.2); transition: all 0.3s ease; z-index: 10000; }
    .mega-menu-close:hover { transform: rotate(90deg) scale(1.1); background: #dc2626; color: white; }
    
    /* MODERN ENHANCEMENTS - Refreshing UI (simplified) */
    .glass-effect {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .gradient-text {
        background: linear-gradient(135deg, #dc2626 0%, #ef4444 50%, #f87171 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        background: linear-gradient(135deg, #fef2f2, #fee2e2);
        color: #dc2626;
        border: 1px solid #fecaca;
    }
    
    .action-button-modern {
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    
    .action-button-modern::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        transform: translate(-50%, -50%);
        transition: width 0.6s, height 0.6s;
    }
    
    .action-button-modern:hover::before {
        width: 300px;
        height: 300px;
    }
    
    .notification-dot {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 8px;
        height: 8px;
        background: #ef4444;
        border-radius: 50%;
        border: 2px solid white;
        animation: blink 1.5s infinite;
    }
    
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }
    
    .card-hover-lift {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .card-hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }
    
    .icon-bounce:hover svg {
        animation: bounce 0.5s;
    }
    
    @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
    }
    
    .smooth-scroll {
        scroll-behavior: smooth;
    }
    
    .text-shadow {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
    }
    
    .border-gradient {
        border: 2px solid transparent;
        background: linear-gradient(white, white) padding-box,
                    linear-gradient(135deg, #dc2626, #ef4444) border-box;
    }
</style>
{% endblock %}

{% block content %}
    <main class="page">
        <!-- Mega Menu Toggle Button -->
        <button id="menuToggle" class="fixed top-6 left-6 z-50 w-12 h-12 bg-white/90 hover:bg-white rounded-full shadow-lg flex items-center justify-center transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-4 focus:ring-red-500/50">
            <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <!-- HERO -->
        <section class="hero min-h-screen relative overflow-hidden hero-section-enhanced">
            <div class="absolute inset-0 z-0">
                <!-- Enhanced background with animated gradient -->
                <div class="absolute inset-0 bg-gradient-to-br from-red-900/20 via-gray-900/80 to-gray-900"></div>
                
                <!-- Floating particles for visual depth -->
                <div class="floating-particle w-4 h-4 bg-red-500/30 top-1/4 left-1/4" style="animation-delay: 0s;"></div>
                <div class="floating-particle w-6 h-6 bg-blue-500/20 top-1/3 right-1/3" style="animation-delay: 1s;"></div>
                <div class="floating-particle w-3 h-3 bg-purple-500/25 bottom-1/4 left-1/3" style="animation-delay: 2s;"></div>
                <div class="floating-particle w-5 h-5 bg-green-500/20 bottom-1/3 right-1/4" style="animation-delay: 3s;"></div>
                
                <!-- Decorative background elements -->
                <div class="absolute inset-0">
                    <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-red-500/10 rounded-full blur-3xl animate-pulse"></div>
                    <div class="absolute bottom-1/3 right-1/4 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                </div>
            </div>
            
            <div class="hero-overlay"></div>
            <div class="hero-content relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 2xl:px-16 py-20">
                <div class="max-w-3xl xl:max-w-4xl 2xl:max-w-5xl">
                    <!-- Trust Badge -->
                    <div class="inline-flex items-center gap-2 px-4 py-2 bg-red-500/10 border border-red-500/30 rounded-full mb-6 animate-on-scroll">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                        </span>
                        <span class="text-sm font-medium text-red-300">Live Platform • 24/7 Active</span>
                    </div>
                    
                    <p class="eyebrow text-red-400 uppercase tracking-wider text-sm font-medium animate-on-scroll">
                        Blood Donation Platform
                    </p>
                    <h1 class="text-4xl md:text-6xl xl:text-7xl 2xl:text-8xl font-bold leading-tight mt-4 animate-on-scroll" style="animation-delay: 0.1s;">
                        Find Blood Donors<br>
                        <span class="bg-gradient-to-r from-red-400 to-red-500 bg-clip-text text-transparent drop-shadow-lg">Near You in Seconds</span>
                    </h1>
                    <p class="hero-copy text-xl xl:text-2xl 2xl:text-3xl text-gray-300 mt-6 animate-on-scroll leading-relaxed" style="animation-delay: 0.2s;">
                        Connect with verified donors instantly. Every 2 seconds, someone needs blood – be the difference between life and death.
                    </p>
                    
                    <!-- Primary CTA Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 mt-8 animate-on-scroll" style="animation-delay: 0.25s;">
                        <a href="/requests/create/" class="btn-animated px-8 py-4 rounded-full text-lg font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300 flex items-center justify-center">
                            Request Blood
                        </a>
                        <a href="/accounts/register/" class="glass-card px-8 py-4 rounded-full text-lg font-semibold hover:bg-white/20 transition-all duration-300 flex items-center justify-center gap-2 group">
                            <svg class="w-5 h-5 text-green-400 group-hover:text-green-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                            </svg>
                            Become a Donor
                        </a>
                    </div>
                    
                    <!-- Quick Stats -->
                    <div class="flex flex-wrap gap-6 mt-6 animate-on-scroll" style="animation-delay: 0.3s;">
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                            <span class="text-sm text-gray-300"><strong class="text-white">1000+</strong> Active Donors</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                            <span class="text-sm text-gray-300"><strong class="text-white">24/7</strong> Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 bg-purple-500 rounded-full"></div>
                            <span class="text-sm text-gray-300"><strong class="text-white">Verified</strong> Network</span>
                        </div>
                    </div>
                    
                    <!-- Public Search Bar for All Users -->
                    <div class="mt-8 animate-on-scroll" style="animation-delay: 0.3s;">
                        <div class="glass-card rounded-2xl p-6 xl:p-8 shadow-xl max-w-4xl mx-auto hover-lift">
                            <h3 class="text-lg xl:text-xl font-semibold text-white mb-2 text-center flex items-center justify-center gap-2">
                                <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                Advanced Search
                            </h3>
                            <p class="text-gray-400 text-sm text-center mb-6">Find donors, users, or create blood requests instantly</p>
                            
                            <form id="home-search-form" class="space-y-4">
                                <!-- Search Type Tabs -->
                                <div class="grid grid-cols-3 gap-2 mb-4">
                                    <button type="button" onclick="setSearchType('donor')" 
                                            class="search-type-btn active px-4 py-3 rounded-lg font-medium transition-all duration-200 bg-red-500 text-white" 
                                            data-type="donor">
                                        <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                        </svg>
                                        Find Donors
                                    </button>
                                    <button type="button" onclick="setSearchType('user')" 
                                            class="search-type-btn px-4 py-3 rounded-lg font-medium transition-all duration-200 bg-white/10 text-gray-300 hover:bg-white/20" 
                                            data-type="user">
                                        <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        Search Users
                                    </button>
                                    <button type="button" onclick="setSearchType('request')" 
                                            class="search-type-btn px-4 py-3 rounded-lg font-medium transition-all duration-200 bg-white/10 text-gray-300 hover:bg-white/20" 
                                            data-type="request">
                                        <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        New Request
                                    </button>
                                </div>
                                
                                <input type="hidden" id="home-search-type" name="search_type" value="donor">
                                
                                <!-- Dynamic Search Fields -->
                                <div id="donor-fields" class="search-fields space-y-4">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-400 mb-2">Blood Group</label>
                                            <select id="home-blood-group" name="blood_group" 
                                                    class="w-full px-4 py-3 bg-gray-900 border border-white/30 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 hover:bg-gray-800 appearance-none cursor-pointer"
                                                    style="-webkit-appearance: none; -moz-appearance: none; appearance: none; text-indent: 1px; text-overflow: '';">
                                                <option value="" class="bg-gray-800">All Blood Groups</option>
                                                <option value="A+" class="bg-gray-800 text-gray-900">A+</option>
                                                <option value="A-" class="bg-gray-800 text-gray-900">A-</option>
                                                <option value="B+" class="bg-gray-800 text-gray-900">B+</option>
                                                <option value="B-" class="bg-gray-800 text-gray-900">B-</option>
                                                <option value="AB+" class="bg-gray-800 text-gray-900">AB+</option>
                                                <option value="AB-" class="bg-gray-800 text-gray-900">AB-</option>
                                                <option value="O+" class="bg-gray-800 text-gray-900">O+</option>
                                                <option value="O-" class="bg-gray-800 text-gray-900">O-</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-400 mb-2">Location (Pincode)</label>
                                            <input type="text" id="home-pincode" name="pincode" 
                                                   placeholder="Enter 6-digit pincode"
                                                   maxlength="6"
                                                   pattern="[0-9]{6}"
                                                   class="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 hover:bg-white/25">
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <input type="checkbox" id="available-only" name="available_only" 
                                               class="w-4 h-4 text-red-500 bg-white/20 border-white/30 rounded focus:ring-red-500">
                                        <label for="available-only" class="text-sm text-gray-300">Show only available donors</label>
                                    </div>
                                </div>
                                
                                <div id="user-fields" class="search-fields hidden space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-400 mb-2">Search Query</label>
                                        <input type="text" id="home-user-query" name="user_query" 
                                               placeholder="Search by name, email, phone, or user ID"
                                               class="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 hover:bg-white/25">
                                    </div>
                                </div>
                                
                                <div id="request-fields" class="search-fields hidden space-y-4">
                                    <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-4">
                                        <p class="text-yellow-300 text-sm flex items-start gap-2">
                                            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                            This will redirect you to the blood request creation form with pre-filled information
                                        </p>
                                    </div>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-400 mb-2">Patient Blood Group</label>
                                            <select id="request-blood-group" name="patient_blood_group" 
                                                    class="w-full px-4 py-3 bg-gray-900 border border-white/30 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 hover:bg-gray-800 appearance-none cursor-pointer"
                                                    style="-webkit-appearance: none; -moz-appearance: none; appearance: none; text-indent: 1px; text-overflow: '';">
                                                <option value="" class="bg-gray-800">Select Blood Group</option>
                                                <option value="A+" class="bg-gray-800 text-gray-900">A+</option>
                                                <option value="A-" class="bg-gray-800 text-gray-900">A-</option>
                                                <option value="B+" class="bg-gray-800 text-gray-900">B+</option>
                                                <option value="B-" class="bg-gray-800 text-gray-900">B-</option>
                                                <option value="AB+" class="bg-gray-800 text-gray-900">AB+</option>
                                                <option value="AB-" class="bg-gray-800 text-gray-900">AB-</option>
                                                <option value="O+" class="bg-gray-800 text-gray-900">O+</option>
                                                <option value="O-" class="bg-gray-800 text-gray-900">O-</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-400 mb-2">City/Location</label>
                                            <input type="text" id="request-city" name="city" 
                                                   placeholder="Enter city name"
                                                   class="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 hover:bg-white/25">
                                        </div>
                                    </div>
                                </div>
                                
                                <button type="submit" 
                                        class="btn-animated w-full text-white py-4 px-6 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center justify-center gap-2 group">
                                    <svg class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                    </svg>
                                    <span id="search-button-text">Search Donors</span>
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    <!-- COMPACT LIVE REQUESTS SECTION -->
                    <div class="mt-8 animate-on-scroll" style="animation-delay: 0.4s;">
                        <div class="bg-white/5 backdrop-blur-lg rounded-xl p-4 md:p-5 border border-white/10">
                            <!-- Compact Header -->
                            <div class="flex items-center justify-between mb-3 md:mb-4">
                                <div class="flex items-center gap-2">
                                    <span class="relative flex h-2 w-2 md:h-3 md:w-3">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 md:h-3 md:w-3 bg-red-500"></span>
                                    </span>
                                    <h3 class="text-sm md:text-base font-semibold text-white">Recent Blood Requests</h3>
                                </div>
                                <a href="/requests/my-requests/" class="text-xs text-blue-400 hover:text-blue-300 transition-colors">Track Yours →</a>
                            </div>
                            
                            <!-- Loading State -->
                            <div id="live-requests-loading" class="text-center py-4 md:py-6">
                                <div class="animate-spin rounded-full h-6 w-6 md:h-8 md:w-8 border-2 border-red-500/30 border-t-red-500 mx-auto"></div>
                                <p class="text-gray-400 text-xs mt-2">Loading...</p>
                            </div>
                            
                            <!-- Compact Requests List - Horizontal scroll on mobile -->
                            <div id="live-requests-container" class="hidden">
                                <div class="overflow-x-auto md:overflow-visible pb-2 md:pb-0 -mx-4 md:mx-0 px-4 md:px-0">
                                    <div class="flex md:grid md:grid-cols-1 gap-2 md:gap-3 min-w-max md:min-w-0" id="live-requests-list">
                                        <!-- Requests populated dynamically -->
                                    </div>
                                </div>
                                <div class="text-center mt-3 md:hidden">
                                    <a href="/requests/" class="text-xs text-red-400 hover:text-red-300 transition-colors">View All Requests →</a>
                                </div>
                            </div>
                            
                            <!-- No Requests -->
                            <div id="no-active-requests" class="hidden text-center py-4 md:py-6">
                                <p class="text-gray-400 text-xs md:text-sm">No active requests right now</p>
                            </div>
                        </div>
                    </div>
                                <a href="/requests/" class="inline-flex items-center gap-2 text-red-400 hover:text-red-300 font-medium transition-colors group">
                                    <span>View all blood requests</span>
                                    <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <script>
                        // Advanced Search Functionality
                        let currentSearchType = 'donor';
                        
                        function setSearchType(type) {
                            currentSearchType = type;
                            
                            // Update hidden input
                            document.getElementById('home-search-type').value = type;
                            
                            // Update button styles
                            document.querySelectorAll('.search-type-btn').forEach(btn => {
                                if (btn.dataset.type === type) {
                                    btn.classList.remove('bg-white/10', 'text-gray-300');
                                    btn.classList.add('bg-red-500', 'text-white');
                                } else {
                                    btn.classList.remove('bg-red-500', 'text-white');
                                    btn.classList.add('bg-white/10', 'text-gray-300');
                                }
                            });
                            
                            // Show/hide field groups
                            document.querySelectorAll('.search-fields').forEach(fields => {
                                fields.classList.add('hidden');
                            });
                            document.getElementById(`${type}-fields`).classList.remove('hidden');
                            
                            // Update button text
                            const buttonTexts = {
                                'donor': 'Search Donors',
                                'user': 'Search Users',
                                'request': 'Create Blood Request'
                            };
                            document.getElementById('search-button-text').textContent = buttonTexts[type];
                        }
                        
                        function handleDonorSearch() {
                            const bloodGroup = document.getElementById('home-blood-group').value;
                            const pincode = document.getElementById('home-pincode').value.trim();
                            const availableOnly = document.getElementById('available-only').checked;
                            
                            let url = '/search/donors/';
                            const params = new URLSearchParams();
                            
                            if (bloodGroup) params.append('blood_group', bloodGroup);
                            if (pincode) params.append('pincode', pincode);
                            if (availableOnly) params.append('available_only', 'true');
                            
                            window.location.href = url + '?' + params.toString();
                        }
                        
                        function handleUserSearch() {
                            const userQuery = document.getElementById('home-user-query').value.trim();
                            
                            if (!userQuery) {
                                showMessage('Please enter a search query', 'error');
                                return;
                            }
                            
                            let url = '/search/users/';
                            const params = new URLSearchParams();
                            params.append('query', userQuery);
                            
                            window.location.href = url + '?' + params.toString();
                        }
                        
                        function handleRequestRedirect() {
                            const bloodGroup = document.getElementById('request-blood-group').value;
                            const city = document.getElementById('request-city').value.trim();
                            
                            let url = '/requests/create/?';
                            const params = new URLSearchParams();
                            
                            if (bloodGroup) params.append('prefill_blood_group', bloodGroup);
                            if (city) params.append('prefill_city', city);
                            
                            window.location.href = url + params.toString();
                        }
                        
                        function showMessage(message, type = 'info') {
                            const messageDiv = document.createElement('div');
                            messageDiv.className = `fixed top-20 right-4 z-50 px-6 py-4 rounded-lg shadow-lg transform transition-all duration-300 ease-in-out max-w-sm ${
                                type === 'success' ? 'bg-green-500' : 
                                type === 'error' ? 'bg-red-500' : 'bg-blue-500'
                            } text-white animate-fade-in-up`;
                            
                            messageDiv.innerHTML = `
                                <div class="flex items-center">
                                    <span>${message}</span>
                                </div>
                                <button onclick="this.parentElement.remove()" class="absolute top-2 right-2 text-white hover:text-gray-200">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            `;
                            
                            document.body.appendChild(messageDiv);
                            
                            setTimeout(() => {
                                if (messageDiv.parentNode) {
                                    messageDiv.remove();
                                }
                            }, 3000);
                        }
                        
                        // Pincode validation
                        document.addEventListener('DOMContentLoaded', function() {
                            const searchForm = document.getElementById('home-search-form');
                            
                            // Initialize with donor search
                            setSearchType('donor');
                            
                            // Handle form submission
                            if (searchForm) {
                                searchForm.addEventListener('submit', function(e) {
                                    e.preventDefault();
                                    
                                    if (currentSearchType === 'donor') {
                                        handleDonorSearch();
                                    } else if (currentSearchType === 'user') {
                                        handleUserSearch();
                                    } else if (currentSearchType === 'request') {
                                        handleRequestRedirect();
                                    }
                                });
                            }
                            
                            // Pincode input validation
                            const pincodeInput = document.getElementById('home-pincode');
                            if (pincodeInput) {
                                pincodeInput.addEventListener('input', function() {
                                    const pincode = this.value;
                                    const errorEl = document.getElementById('pincode-error');
                                    if (errorEl) {
                                        if (pincode && !/^[0-9]{6}$/.test(pincode)) {
                                            errorEl.classList.remove('hidden');
                                        } else {
                                            errorEl.classList.add('hidden');
                                        }
                                    }
                                });
                            }
                        });
                    </script>
                    
                    <!-- Live Blood Requests Loading Script -->
                    <script>
                        // Load live blood requests for homepage
                        async function loadLiveRequests() {
                            const loadingEl = document.getElementById('live-requests-loading');
                            const containerEl = document.getElementById('live-requests-container');
                            const listEl = document.getElementById('live-requests-list');
                            const noRequestsEl = document.getElementById('no-active-requests');
                            
                            try {
                                const response = await fetch('/api/requests/live/');
                                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                                
                                const requests = await response.json();
                                
                                // Hide loading
                                if (loadingEl) loadingEl.classList.add('hidden');
                                
                                if (!requests || requests.length === 0) {
                                    // Show no requests message
                                    if (noRequestsEl) noRequestsEl.classList.remove('hidden');
                                    if (containerEl) containerEl.classList.add('hidden');
                                    return;
                                }
                                
                                // Show container
                                if (containerEl) containerEl.classList.remove('hidden');
                                if (noRequestsEl) noRequestsEl.classList.add('hidden');
                                
                                // Display requests (limit to 5 for homepage)
                                const displayRequests = requests.slice(0, 5);
                                listEl.innerHTML = displayRequests.map(request => {
                                    const urgencyColors = {
                                        'emergency': 'bg-red-500 animate-pulse',
                                        'urgent': 'bg-orange-500',
                                        'normal': 'bg-blue-500'
                                    };
                                    
                                    // Use correct field names from API response
                                    const colorClass = urgencyColors[request.urgency] || urgencyColors.normal;
                                    const bloodGroup = request.blood_group || 'N/A';
                                    const hospital = request.hospital || 'Unknown Hospital';
                                    const location = request.location || 'Unknown';
                                    const timeAgo = request.time_ago || 'Recently';
                                    
                                    return `
                                        <div class="flex-shrink-0 w-64 md:w-full bg-white/5 hover:bg-white/10 rounded-lg p-3 border border-white/10 transition-all cursor-pointer" onclick="window.location.href='/requests/${request.id}/'">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="${colorClass} text-white px-2 py-0.5 rounded text-xs font-semibold">
                                                    ${(request.urgency || 'NORMAL').toUpperCase()}
                                                </span>
                                                <span class="text-white font-bold text-sm">${bloodGroup}</span>
                                            </div>
                                            <h4 class="text-white text-sm font-semibold truncate">${hospital}</h4>
                                            <p class="text-gray-400 text-xs mt-1 truncate">📍 ${location}</p>
                                            <p class="text-gray-500 text-xs mt-1">⏰ ${timeAgo}</p>
                                        </div>
                                    `;
                                }).join('');
                                
                            } catch (error) {
                                console.error('Error loading live requests:', error);
                                if (loadingEl) {
                                    loadingEl.innerHTML = `
                                        <div class="text-center py-4">
                                            <p class="text-red-400 text-xs">Failed to load requests</p>
                                            <button onclick="loadLiveRequests()" class="mt-2 px-3 py-1 bg-red-500/20 hover:bg-red-500/30 rounded text-xs text-red-400">Retry</button>
                                        </div>
                                    `;
                                }
                            }
                        }
                        
                        // Helper function to format time ago
                        function getTimeAgo(dateString) {
                            const now = new Date();
                            const date = new Date(dateString);
                            const seconds = Math.floor((now - date) / 1000);
                            
                            if (seconds < 60) return 'Just now';
                            if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
                            if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
                            return `${Math.floor(seconds / 86400)}d ago`;
                        }
                        
                        // Load on page ready
                        document.addEventListener('DOMContentLoaded', function() {
                            loadLiveRequests();
                            // Refresh every 30 seconds
                            setInterval(loadLiveRequests, 30000);
                        });
                    </script>
                    
                    <!-- Quick Action Buttons -->
                    <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
                        <a href="/search/donors/" 
                           class="glass-card hover-lift p-4 rounded-xl font-semibold text-center flex items-center justify-center group">
                            <svg class="w-5 h-5 mr-2 text-red-400 group-hover:text-red-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zM6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                            <span class="text-white group-hover:text-red-300 transition-colors">Find Donor</span>
                        </a>
                        <a href="/search/users/" 
                           class="glass-card hover-lift p-4 rounded-xl font-semibold text-center flex items-center justify-center group">
                            <svg class="w-5 h-5 mr-2 text-red-400 group-hover:text-red-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span class="text-white group-hover:text-red-300 transition-colors">Search User</span>
                        </a>
                        <a href="/requests/create/" 
                           class="glass-card hover-lift p-4 rounded-xl font-semibold text-center flex items-center justify-center group">
                            <span class="text-white group-hover:text-red-300 transition-colors">Create Request</span>
                        </a>
                    </div>
                    <div class="hero-actions mt-8 flex flex-col sm:flex-row flex-wrap gap-4 justify-center animate-on-scroll" style="animation-delay: 0.3s;">
                        <a href="#join" class="btn-animated px-8 py-4 rounded-full text-lg font-semibold shadow-lg hover:shadow-xl w-full sm:w-auto text-center transform hover:scale-105 transition-all duration-300">
                            Become a donor
                        </a>
                        <a href="#story" class="glass-card px-8 py-4 rounded-full text-lg font-semibold w-full sm:w-auto text-center hover:bg-white/20 transition-all duration-300">
                            Why it matters
                        </a>
                    </div>
                </div>
            </div>
            <div class="hero-media scroll-parallax relative z-10">
                <div class="hero-media-card bg-white/10 backdrop-blur-md rounded-2xl p-6 max-w-xs ml-auto animate-on-scroll every-2-seconds-card" style="animation-delay: 0.4s;">
                    <p class="hero-stat-label text-red-400 uppercase tracking-wide text-sm">Every 2 seconds</p>
                    <p class="hero-stat-value text-white text-2xl font-bold">someone needs blood.</p>
                </div>
            </div>
        </section>

        <!-- 01 STORY -->
        <section id="story" class="story-block py-20 xl:py-28 2xl:py-32 relative">
            <div class="story-label scroll-fade max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 animate-on-scroll">
                <span class="story-index text-2xl font-bold text-red-500">01</span>
                <span class="story-tag text-gray-400 uppercase tracking-wider ml-4">Why blood donation matters</span>
            </div>
            <div class="story-body scroll-fade max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 mt-8 animate-on-scroll" style="animation-delay: 0.1s;">
                <h2 class="text-3xl md:text-4xl xl:text-5xl font-bold text-white mb-8 leading-tight">Blood can't be manufactured. It has to be given.</h2>
                <p class="text-xl xl:text-2xl text-gray-300 mb-8 leading-relaxed">
                    In emergencies, surgeries, cancer treatments, childbirth complications, and chronic illnesses,
                    safe blood is often the one thing that decides whether a patient gets a second chance.
                </p>
                <div class="story-grid grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
                    <div class="glass-card hover-lift p-6 xl:p-8 animate-on-scroll periodic-highlight" style="animation-delay: 0.2s;">
                        <h3 class="text-xl xl:text-2xl font-semibold text-white mb-3">Emergencies</h3>
                        <p class="text-gray-300 leading-relaxed">Accidents, trauma, and disasters require immediate transfusions when every minute counts.</p>
                    </div>
                    <div class="glass-card hover-lift p-6 xl:p-8 animate-on-scroll periodic-highlight" style="animation-delay: 0.3s;">
                        <h3 class="text-xl xl:text-2xl font-semibold text-white mb-3">Treatments</h3>
                        <p class="text-gray-300 leading-relaxed">Cancer, thalassemia, sickle cell disease, and major surgeries all depend on regular blood and platelet support.</p>
                    </div>
                    <div class="glass-card hover-lift p-6 xl:p-8 animate-on-scroll periodic-highlight" style="animation-delay: 0.4s;">
                        <h3 class="text-xl xl:text-2xl font-semibold text-white mb-3">India's gap</h3>
                        <p class="text-gray-300 leading-relaxed">Millions of units are needed each year, yet many hospitals still face shortages – especially for rare groups.</p>
                    </div>
                </div>
            </div>

        </section>

        <!-- 02 HOW IT WORKS -->
        <section id="how-it-works" class="story-block py-20 xl:py-28 2xl:py-32 relative bg-gradient-to-b from-gray-900/50 to-gray-800/50">
            <div class="story-label scroll-fade max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 animate-on-scroll">
                <span class="story-index text-2xl font-bold text-red-500">02</span>
                <span class="story-tag text-gray-400 uppercase tracking-wider ml-4">How the platform works</span>
            </div>
            <div class="story-body scroll-fade max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 mt-8 animate-on-scroll" style="animation-delay: 0.1s;">
                <h2 class="text-3xl md:text-4xl xl:text-5xl font-bold text-white mb-8 leading-tight">From request to donation in a few simple steps.</h2>
                <p class="text-xl xl:text-2xl text-gray-300 leading-relaxed">Our platform connects hospitals with verified blood donors through a secure, streamlined process that ensures timely and reliable blood supply for patients in need.</p>
                <ol class="steps space-y-8 mt-8">
                    <li class="flex items-start glass-card hover-lift p-6 rounded-xl animate-on-scroll" style="animation-delay: 0.2s;">
                        <div class="flex-shrink-0 w-8 h-8 bg-red-500 rounded-full flex items-center justify-center text-white font-bold mr-4">1</div>
                        <div>
                            <h3 class="text-xl xl:text-2xl font-semibold text-white">Hospitals create a request</h3>
                            <p class="text-gray-300 leading-relaxed">Doctors or admins log in, add the patient's blood group, urgency, location, and contact details.</p>
                        </div>
                    </li>
                    <li class="flex items-start glass-card hover-lift p-6 rounded-xl animate-on-scroll" style="animation-delay: 0.3s;">
                        <div class="flex-shrink-0 w-8 h-8 bg-red-500 rounded-full flex items-center justify-center text-white font-bold mr-4">2</div>
                        <div>
                            <h3 class="text-xl xl:text-2xl font-semibold text-white">Smart matching finds nearby donors</h3>
                            <p class="text-gray-300 leading-relaxed">Our algorithm checks blood group compatibility, distance, and donor availability to suggest best matches.</p>
                        </div>
                    </li>
                    <li class="flex items-start glass-card hover-lift p-6 rounded-xl animate-on-scroll" style="animation-delay: 0.4s;">
                        <div class="flex-shrink-0 w-8 h-8 bg-red-500 rounded-full flex items-center justify-center text-white font-bold mr-4">3</div>
                        <div>
                            <h3 class="text-xl xl:text-2xl font-semibold text-white">Donors are notified instantly</h3>
                            <p class="text-gray-300 leading-relaxed">Verified donors receive clear, actionable notifications and can respond quickly to help.</p>
                        </div>
                    </li>
                </ol>
            </div>

        </section>

        <!-- 03 IMPACT -->
        <section id="impact" class="impact-block py-20 xl:py-28 2xl:py-32">
            <div class="impact-inner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 animate-on-scroll">
                <div class="impact-header text-center mb-12">
                    <span class="story-index text-2xl font-bold text-red-500">03</span>
                    <span class="story-tag text-gray-400 uppercase tracking-wider ml-4">Impact at a glance</span>
                </div>
                <h2 class="text-3xl md:text-4xl xl:text-5xl font-bold text-center text-white mb-16 leading-tight">Designed for people first – donors, patients, and hospitals.</h2>
                <div class="impact-grid grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="glass-card hover-lift p-8 xl:p-10 text-center border border-white/10 animate-on-scroll periodic-highlight" style="animation-delay: 0.1s;">
                        <p class="impact-number text-5xl xl:text-6xl font-bold stat-value mb-4" data-count-to="3">0</p>
                        <p class="impact-text text-gray-300 leading-relaxed">Patients who can benefit from a single blood donation (red cells, plasma, platelets).</p>
                    </div>
                    <div class="glass-card hover-lift p-8 xl:p-10 text-center border border-white/10 animate-on-scroll periodic-highlight" style="animation-delay: 0.2s;">
                        <p class="impact-number text-5xl xl:text-6xl font-bold stat-value mb-4" data-count-to="90">0</p>
                        <p class="impact-text text-gray-300 leading-relaxed">Days is the typical safe gap between donations – our system helps donors track this.</p>
                    </div>
                    <div class="glass-card hover-lift p-8 xl:p-10 text-center border border-white/10 animate-on-scroll periodic-highlight" style="animation-delay: 0.3s;">
                        <p class="impact-number text-5xl xl:text-6xl font-bold stat-value mb-4" data-count-to="24">0</p>
                        <p class="impact-text text-gray-300 leading-relaxed">Requests and matches can be created, monitored, and updated at any time.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 04 JOIN -->
        <section id="join" class="join-block py-20 xl:py-28 2xl:py-32">
            <div class="join-inner max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 animate-on-scroll">
                <div class="join-pill text-center text-sm uppercase tracking-wider text-white bg-white/10 backdrop-blur-md rounded-full py-2 px-6 inline-block mb-8 border border-white/20">
                    04 · Take the next step
                </div>
                <h2 class="text-3xl md:text-4xl xl:text-5xl font-bold text-center text-white mb-6 leading-tight">Ready to help? Start where you are.</h2>
                <p class="join-copy text-center text-xl xl:text-2xl text-gray-300 mb-10 leading-relaxed">
                    If you are healthy and eligible, donating blood once every 3–4 months can change someone's story.
                    Hospitals and blood banks can use this platform to make every unit count.
                </p>
                <div class="join-actions flex flex-wrap justify-center gap-6 mb-10">
                    <a href="/accounts/register/" class="btn-animated px-8 py-4 rounded-full text-lg font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300">
                        Register as donor
                    </a>
                    <a href="/admin/" class="glass-card px-8 py-4 rounded-full text-lg font-semibold hover:bg-white/20 transition-all duration-300">
                        Hospital / admin login
                    </a>
                </div>
                <p class="join-note text-center text-gray-400">
                    Not sure if you're eligible? Your local blood bank will guide you on age, weight, health, and donation intervals.
                </p>
            </div>
        </section>
        
        <!-- TRUST & SAFETY SECTION -->
        <section class="py-20 xl:py-28 2xl:py-32 bg-gradient-to-b from-gray-900/50 to-transparent">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
                <div class="text-center mb-12 animate-on-scroll">
                    <span class="story-index text-2xl font-bold text-red-500">Trust & Safety</span>
                    <h2 class="text-3xl md:text-4xl xl:text-5xl font-bold text-white mt-4 mb-6">Your Safety is Our Priority</h2>
                    <p class="text-xl text-gray-300 max-w-3xl mx-auto">We ensure secure, verified connections between donors and patients</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="glass-card hover-lift p-8 text-center animate-on-scroll" style="animation-delay: 0.1s;">
                        <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-white mb-3">Verified Donors</h3>
                        <p class="text-gray-300">All donors undergo verification process ensuring authentic and reliable connections</p>
                    </div>
                    
                    <div class="glass-card hover-lift p-8 text-center animate-on-scroll" style="animation-delay: 0.2s;">
                        <div class="w-16 h-16 bg-blue-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-white mb-3">Secure Contact</h3>
                        <p class="text-gray-300">End-to-end encrypted communication protecting your privacy at all times</p>
                    </div>
                    
                    <div class="glass-card hover-lift p-8 text-center animate-on-scroll" style="animation-delay: 0.3s;">
                        <div class="w-16 h-16 bg-purple-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-white mb-3">Privacy Protected</h3>
                        <p class="text-gray-300">Your personal information is never shared without explicit consent</p>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- JavaScript for Enhanced Features -->
        <script>
            // Count Animation for Stats
            function animateCounters() {
                const counters = document.querySelectorAll('[data-count-to]');
                
                counters.forEach(counter => {
                    const target = parseInt(counter.getAttribute('data-count-to'));
                    const duration = 2000; // 2 seconds
                    const step = target / (duration / 16); // 60fps
                    let current = 0;
                    
                    const updateCounter = () => {
                        current += step;
                        if (current < target) {
                            counter.textContent = Math.floor(current);
                            requestAnimationFrame(updateCounter);
                        } else {
                            counter.textContent = target;
                        }
                    };
                    
                    // Start animation when element is in viewport
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                updateCounter();
                                observer.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.5 });
                    
                    observer.observe(counter);
                });
            }
            
            // Smooth Scroll for Anchor Links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
            
            // Initialize on page load - SIMPLIFIED
            document.addEventListener('DOMContentLoaded', function() {
                animateCounters();
                
                // Simplified scroll-triggered animations (reduced threshold for better performance)
                const observerOptions = {
                    threshold: 0.05, // Lower threshold for faster trigger
                    rootMargin: '0px'
                };
                
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.style.opacity = '1';
                            entry.target.style.transform = 'translateY(0)';
                            observer.unobserve(entry.target); // Stop observing after animation
                        }
                    });
                }, observerOptions);
                
                // Apply initial state and observe elements
                document.querySelectorAll('.animate-on-scroll').forEach(el => {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(10px)'; // Reduced from 20px
                    el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                    observer.observe(el);
                });
            });
        </script>
        
        <!-- Floating Action Button for Quick Actions -->
        <div class="fixed bottom-6 right-6 z-40" x-data="{ open: false }">
            <!-- Main FAB -->
            <button 
                @click="open = !open"
                class="w-14 h-14 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-4 focus:ring-red-500/50"
                :class="{ 'rotate-45': open }"
            >
                <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" :class="{ 'rotate-45': open }">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
            </button>
            
            <!-- Action Menu -->
            <div 
                x-show="open"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-90 translate-y-2"
                x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                x-transition:leave-end="opacity-0 scale-90 translate-y-2"
                class="absolute bottom-16 right-0 space-y-3 mb-2"
                @click.away="open = false"
            >
                <!-- Find Donors -->
                <a href="/search/donors/" class="flex items-center gap-3 group">
                    <span class="text-sm font-medium text-white bg-gray-900/90 px-3 py-1.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Find Donors</span>
                    <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </a>
                
                <!-- Create Request -->
                <a href="/requests/create/" class="flex items-center gap-3 group">
                    <span class="text-sm font-medium text-white bg-gray-900/90 px-3 py-1.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Create Request</span>
                    <div class="w-12 h-12 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </a>
                
                {% if user.is_authenticated %}
                <!-- Track Requests -->
                <a href="/requests/my-requests/" class="flex items-center gap-3 group">
                    <span class="text-sm font-medium text-white bg-gray-900/90 px-3 py-1.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Track Requests</span>
                    <div class="w-12 h-12 bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                    </div>
                </a>
                
                <!-- Dashboard -->
                <a href="/accounts/dashboard/" class="flex items-center gap-3 group">
                    <span class="text-sm font-medium text-white bg-gray-900/90 px-3 py-1.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Dashboard</span>
                    <div class="w-12 h-12 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                    </div>
                </a>
                {% else %}
                <!-- Login -->
                <a href="/accounts/login/" class="flex items-center gap-3 group">
                    <span class="text-sm font-medium text-white bg-gray-900/90 px-3 py-1.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Login</span>
                    <div class="w-12 h-12 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                        </svg>
                    </div>
                </a>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}





