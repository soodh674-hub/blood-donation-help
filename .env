# SUPABASE_PORT=5432
# SUPABASE_DBNAME=postgres
# SUPABASE_USER=postgres
# SUPABASE_PASSWORD=your-supabase-password
# SUPABASE_PROJECT_REF=your-project-ref

# Legacy MySQL Configuration (commented out)
# DB_NAME=blood_donation_db
# DB_USER=root
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=3306

# Redis Configuration (Commented for development)
# REDIS_URL=redis://localhost:6379/0

# Email Configuration - Brevo HTTP API (Recommended for Render/Production)
EMAIL_BACKEND=blood_donation.email_backend.BrevoAPIEmailBackend
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
DEFAULT_FROM_EMAIL=noreply@bloodis-life.online
DEFAULT_FROM_EMAIL_NAME=Blood Help

# Alternative: SMTP Backend (if HTTP API doesn't work)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=a4408b001@smtp-brevo.com
# EMAIL_HOST_PASSWORD=YOUR_BREVO_SMTP_PASSWORD_HERE

# Maps Configuration - Using FREE OpenStreetMap + Leaflet (NO API KEY REQUIRED!)
# Maps work out of the box with OpenStreetMap - completely free!
# Optional: If you want Google Maps instead, add your key below
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Celery Configuration (Commented for development)
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# JWT Settings
JWT_EXPIRATION_DELTA=7 days

# Site URL (for email notifications and links)
SITE_URL=https://bloodis-life.online

# SMS Configuration - Twilio (Optional - for SMS notifications)
# Sign up at https://www.twilio.com to get these credentials
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890