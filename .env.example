# ============================================================
# BloodLife Platform - Environment Variables Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# FOR RENDER DEPLOYMENT:
# - Set these variables in your Render Dashboard -> Environment Variables
# - Use render.yaml for automatic configuration
# - DATABASE_URL will be auto-configured if you use Render PostgreSQL
# ============================================================

# -----------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production-use-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,*.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://*.onrender.com

# -----------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------
# For Render: Use PostgreSQL database URL from dashboard
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/bloodlife_db

# Alternative: Individual database settings (if not using DATABASE_URL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bloodlife_db
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# For development only (NOT for production):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# -----------------------------------------------------------
# REDIS CONFIGURATION (Required for Celery & WebSockets)
# -----------------------------------------------------------
# For Render: Use Redis instance URL
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------
# EMAIL CONFIGURATION - Brevo HTTP API (Recommended for Render)
# -----------------------------------------------------------
# Get your API key from: https://app.brevo.com/
# Profile -> SMTP & API -> API Keys
# Key MUST start with "xkeysib-"
EMAIL_BACKEND=blood_donation.email_backend.BrevoAPIEmailBackend
BREVO_API_KEY=xkeysib-your-brevo-http-api-key-here
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_FROM_EMAIL_NAME=BloodLife Platform

# Alternative SMTP Configuration (if not using Brevo):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# -----------------------------------------------------------
# CELERY CONFIGURATION (Background Tasks)
# -----------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------
# JWT AUTHENTICATION SETTINGS
# -----------------------------------------------------------
JWT_EXPIRATION_DELTA=7
JWT_REFRESH_EXPIRATION_DELTA=30
JWT_SECRET_KEY=your-jwt-secret-key-different-from-django-secret

# -----------------------------------------------------------
# GOOGLE MAPS API CONFIGURATION
# -----------------------------------------------------------
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# -----------------------------------------------------------
# WEBSOCKET / DJANGO CHANNELS CONFIGURATION
# -----------------------------------------------------------
# For production: Use Redis channel layer
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_LAYERS_CONFIG={"hosts": [("localhost", 6379)]}

# For development (in-memory):
# CHANNEL_LAYERS_BACKEND=channels.layers.InMemoryChannelLayer

# -----------------------------------------------------------
# SECURITY SETTINGS (Production Only)
# -----------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# -----------------------------------------------------------
# STATIC & MEDIA FILES
# -----------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=/opt/render/project/src/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/opt/render/project/src/media

# For AWS S3 (optional):
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# -----------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# -----------------------------------------------------------
# SUPERUSER CONFIGURATION (Optional - Auto-create on deploy)
# -----------------------------------------------------------
CREATE_SUPERUSER=false
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@yourdomain.com
SUPERUSER_PASSWORD=change-this-to-secure-password

# -----------------------------------------------------------
# THIRD-PARTY API KEYS (Optional)
# -----------------------------------------------------------
# Twilio for SMS notifications
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Firebase for Push Notifications
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email

# -----------------------------------------------------------
# PERFORMANCE & CACHING
# -----------------------------------------------------------
# Redis cache (recommended)
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://localhost:6379/1

# For development:
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake

# -----------------------------------------------------------
# CORS SETTINGS (If using separate frontend)
# -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# ============================================================
# DEPLOYMENT CHECKLIST
# ============================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate secure SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 3. Set up PostgreSQL database on Render
# 4. Set up Redis instance on Render (for WebSockets & Celery)
# 5. Get Google Maps API key from Google Cloud Console
# 6. Set up Brevo email API key (or use SMTP)
# 7. Update ALLOWED_HOSTS with your domain
# 8. Set DEBUG=False for production
# 9. Configure all environment variables in Render dashboard
# 10. Test locally before deploying
# ============================================================