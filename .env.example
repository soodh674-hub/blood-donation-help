# Blood Donation Platform - Environment Variables

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Configuration
DB_NAME=blood_donation_db
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Email Configuration - Brevo HTTP API (NOT SMTP - More Reliable on Render)
# Get your API key from: https://app.brevo.com/ -> Profile -> SMTP & API -> API Keys
# Key MUST start with "xkeysib-"
EMAIL_BACKEND=blood_donation.email_backend.BrevoAPIEmailBackend
BREVO_API_KEY=xkeysib-your-brevo-http-api-key-here-get-from-brevo-dashboard
DEFAULT_FROM_EMAIL=noreply@bloodis-life.online
DEFAULT_FROM_EMAIL_NAME=Blood Help

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_EXPIRATION_DELTA=7 days